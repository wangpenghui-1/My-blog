{{- $index := slice -}}
{{- range site.RegularPages.ByDate.Reverse -}}
  {{- if and (not .Params.searchHidden) (ne .Layout "search") (ne .Layout "garden-search") -}}
    {{- $section := "Essay" -}}
    {{- with .CurrentSection }}{{ $section = .Title }}{{ end -}}
    {{- $index = $index | append (dict "title" .Title "summary" (.Summary | plainify | htmlUnescape) "permalink" .RelPermalink "section" $section "tags" (.Params.tags | default (slice)) "date" (.Date.Format "2006-01-02T15:04:05Z07:00")) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
